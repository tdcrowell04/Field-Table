<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds the simulation outside Unity, from the same source files Unity uses
    (../com.fieldtable.sim/Runtime). Targets what Unity 6 supports: .NET Standard 2.1, C# 9.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>FieldTable.Sim</RootNamespace>
    <AssemblyName>FieldTable.Sim</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../com.fieldtable.sim/Runtime/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Matches the Newtonsoft.Json that Unity's com.unity.nuget.newtonsoft-json package ships. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FieldTable.Sim.Tests" />
  </ItemGroup>

</Project>
